<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lucento lint policy. Errors block CI; warnings are reported and triaged in docs/QUALITY.md.
  Promoted to error: problems that would leak data, break the release, or hurt accessibility.
-->
<lint>
    <!-- Privacy and release safety -->
    <issue id="AllowBackup" severity="error" />
    <issue id="HardcodedDebugMode" severity="error" />
    <issue id="SecureRandom" severity="error" />
    <issue id="TrustAllX509TrustManager" severity="error" />
    <issue id="ExportedContentProvider" severity="error" />
    <issue id="SetJavaScriptEnabled" severity="error" />
    <issue id="MissingPermission" severity="error" />
    <!-- Resources and correctness -->
    <issue id="MissingTranslation" severity="ignore" />
    <issue id="UnusedResources" severity="warning" />
    <!-- Dependency freshness is reviewed deliberately (version catalog), not on every build. -->
    <issue id="GradleDependency" severity="informational" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="informational" />
    <!-- Accessibility -->
    <issue id="ContentDescription" severity="warning" />
</lint>
