<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Lucento is local-first; every core feature works fully offline with no account. INTERNET is needed
        only for the optional, opt-in cloud sync (see docs/SYNC.md) — nothing reaches the network until the
        user explicitly signs in and turns sync on in Settings. ACCESS_NETWORK_STATE lets sync wait for a
        connection instead of failing noisily when there isn't one. ML Kit's own (unrelated, optional)
        telemetry permissions are still stripped: this app grants no permission it does not itself use.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WorkManager merges WAKE_LOCK and RECEIVE_BOOT_COMPLETED (both used: background sync and re-scheduling it
         after a reboot) plus FOREGROUND_SERVICE, which sync never uses — so that one is removed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- The camera and speech recogniser are other apps the user hands off to; Lucento itself needs no
         CAMERA or RECORD_AUDIO permission. Declared so Android 11+ lets Lucento see whether they exist. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".LucentoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lucento"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lucento.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares one cached receipt photo with the camera app during capture; deleted after reading. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
